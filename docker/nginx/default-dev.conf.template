# Linux/runtime:
# - web.format.local ou IP do servidor -> frontend estatico em /usr/share/nginx/html
# - /api, OAuth e Swagger -> backend format-web em ${NGINX_WEB_UPSTREAM}
# - api.format.local -> container api
# - auth.format.local -> container auth

server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate /etc/nginx/ssl/format.local.crt;
    ssl_certificate_key /etc/nginx/ssl/format.local.key;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 100M;
    client_body_buffer_size 100M;

    location /api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $backend ${NGINX_WEB_UPSTREAM};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    location /oauth2/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $backend ${NGINX_WEB_UPSTREAM};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    location /login/oauth2/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $backend ${NGINX_WEB_UPSTREAM};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    location /swagger-ui/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $backend ${NGINX_WEB_UPSTREAM};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    location /v3/api-docs/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $backend ${NGINX_WEB_UPSTREAM};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    listen 443 ssl;
    server_name auth.format.local;

    ssl_certificate /etc/nginx/ssl/format.local.crt;
    ssl_certificate_key /etc/nginx/ssl/format.local.key;

    location / {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $upstream http://auth:8090;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_buffer_size 64k;
        proxy_buffers 8 64k;
    }
}

server {
    listen 80;
    listen 443 ssl;
    server_name api.format.local;

    ssl_certificate /etc/nginx/ssl/format.local.crt;
    ssl_certificate_key /etc/nginx/ssl/format.local.key;

    client_max_body_size 100M;
    client_body_buffer_size 100M;

    location / {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $upstream http://api:8082;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
    }
}
