# Copie para .env ou rode um dos scripts:
# - usar-ambiente-local.bat
# - usar-ambiente-linux.bat 192.168.69.225

# URL publica usada pelo browser.
FORMAT_FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_PORT=5173

# Upstreams variam por ambiente:
# - local com web no Eclipse: http://host.docker.internal:8081 / http://localhost:8081
# - Linux/Docker: http://web:8081
NGINX_WEB_UPSTREAM=http://host.docker.internal:8081
VITE_PROXY_TARGET=http://host.docker.internal:8081

SPRING_WEB_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8090

# O issuer precisa ser a URL publica do Auth, pois ele aparece dentro do JWT.
FORMAT_AUTH_ISSUER=http://localhost:8090
FORMAT_AUTH_AUTHORIZATION_URI=http://localhost:8090/oauth2/authorize
FORMAT_AUTH_LOGOUT_URI=http://localhost:8090/connect/logout

# Dentro do Docker, prefira auth:8090. Fora do Docker, use localhost:8090.
FORMAT_AUTH_TOKEN_URI=http://auth:8090/oauth2/token
FORMAT_AUTH_USER_INFO_URI=http://auth:8090/userinfo
FORMAT_AUTH_JWK_SET_URI=http://auth:8090/oauth2/jwks
FORMAT_AUTH_WEB_REDIRECT_URI=http://localhost:5173/login/oauth2/code/oidc
FORMAT_AUTH_WEB_REDIRECT_URIS=http://localhost:5173/login/oauth2/code/oidc,http://localhost:8081/login/oauth2/code/oidc
FORMAT_AUTH_WEB_POST_LOGOUT_REDIRECT_URIS=http://localhost:5173/login?logout,http://localhost:8081/login?logout

# Dentro do Docker, use http://api:8082. Fora do Docker, use http://localhost:8082.
FORMAT_API_BASE_URL=http://api:8082
FORMAT_API_TOKEN_URI=http://auth:8090/oauth2/token
FORMAT_API_CLIENT_ID=format-api-client
FORMAT_API_CLIENT_SECRET=format-api-secret
FORMAT_API_CLIENT_SCOPE=format.process format.read format.admin